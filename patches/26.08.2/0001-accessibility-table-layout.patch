+    const KItemListViewLayouter *layouter = view()->m_layouter;
+    const bool vertical = layouter->scrollOrientation() == Qt::Vertical;
+    // Asking for an item first makes sure the layout is up to date.
+    const int layoutRows = (vertical ? layouter->itemRow(count - 1) : layouter->itemColumn(count - 1)) + 1;
+    return vertical ? qMin(count, layouter->columnCount()) : layoutRows;
 }
 
