 QAccessibleInterface *KItemListViewAccessible::cellAt(int row, int column) const
 {
-    return accessibleDelegate(columnCount() * row + column);
+    const int count = view()->model()->count();
+    if (row < 0 || column < 0 || count <= 0) {
+        return nullptr;
+    }
+
+    // Use the positions the layouter gave to the items. A group header starts a new row, so the row
+    // of an item cannot be derived from its index. Items are ordered by row: search the first of them.
+    const KItemListViewLayouter *layouter = view()->m_layouter;
+    const bool vertical = layouter->scrollOrientation() == Qt::Vertical;
+    const int layoutRow = vertical ? row : column;
+    const int layoutColumn = vertical ? column : row;
+    const auto rowOf = [layouter, vertical](int index) {
+        return vertical ? layouter->itemRow(index) : layouter->itemColumn(index);
+    };
+    int low = 0;
+    int high = count;
+    while (low < high) {
+        const int middle = low + (high - low) / 2;
+        if (rowOf(middle) < layoutRow) {
+            low = middle + 1;
+        } else {
+            high = middle;
+        }
+    }
+    const int index = low + layoutColumn;
+    if (index >= count || rowOf(index) != layoutRow) {
+        return nullptr;
+    }
+    return accessibleDelegate(index);
 }
 
