@@ -0,0 +1,238 @@
+/*
+    SPDX-FileCopyrightText: 2026 Dolphin macOS contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "quicklook_macos.h"
+#include <QElapsedTimer>
+#include <QTimer>
+#include <QWidget>
+
+#import <AppKit/AppKit.h>
+#import <QuickLookUI/QuickLookUI.h>
+
+@interface DolphinQuickLookSource : NSResponder <QLPreviewPanelDataSource, QLPreviewPanelDelegate>
+@property(nonatomic, strong) NSArray<NSURL *> *urls;
+@property(nonatomic, weak) NSWindow *window;
+@property(nonatomic, weak) NSResponder *previousResponder;
+@property(nonatomic) BOOL enabled;
+@end
+
+@implementation DolphinQuickLookSource
+- (BOOL)acceptsPreviewPanelControl:(QLPreviewPanel *)panel
+{
+    return self.enabled;
+}
+
+- (void)beginPreviewPanelControl:(QLPreviewPanel *)panel
+{
+    panel.dataSource = self;
+    panel.delegate = self;
+    [panel reloadData];
+}
+
+- (void)endPreviewPanelControl:(QLPreviewPanel *)panel
+{
+    if (panel.dataSource == self) {
+        panel.dataSource = nil;
+    }
+    if (panel.delegate == self) {
+        panel.delegate = nil;
+    }
+}
+
+- (BOOL)previewPanel:(QLPreviewPanel *)panel handleEvent:(NSEvent *)event
+{
+    if (event.type != NSEventTypeKeyDown || !self.enabled || !self.window) {
+        return NO;
+    }
+    switch (event.keyCode) {
+    case 123: // Left arrow.
+    case 124: // Right arrow.
+    case 125: // Down arrow.
+    case 126: // Up arrow.
+        [self.window sendEvent:event];
+        return YES;
+    default:
+        return NO;
+    }
+}
+
+- (NSInteger)numberOfPreviewItemsInPreviewPanel:(QLPreviewPanel *)panel
+{
+    return self.urls.count;
+}
+
+- (id<QLPreviewItem>)previewPanel:(QLPreviewPanel *)panel previewItemAtIndex:(NSInteger)index
+{
+    return self.urls[index];
+}
+@end
+
+namespace
+{
+bool requested = false;
+bool openingDeferred = false;
+quint64 requestGeneration = 0;
+QElapsedTimer lastExplicitClose;
+const QWidget *panelOwner = nullptr;
+
+DolphinQuickLookSource *activeSource = nil;
+NSMutableArray<DolphinQuickLookSource *> *retiredSources = nil;
+
+DolphinQuickLookSource *source()
+{
+    return activeSource;
+}
+
+void discardReleasedSources()
+{
+    QLPreviewPanel *panel = [QLPreviewPanel sharedPreviewPanelExists] ? [QLPreviewPanel sharedPreviewPanel] : nil;
+    for (DolphinQuickLookSource *controller in [retiredSources copy]) {
+        if (panel.currentController != controller && panel.dataSource != controller && panel.delegate != controller) {
+            [retiredSources removeObject:controller];
+        }
+    }
+}
+
+NSArray<NSURL *> *toNSUrls(const QList<QUrl> &files)
+{
+    NSMutableArray<NSURL *> *urls = [NSMutableArray arrayWithCapacity:files.size()];
+    for (const QUrl &file : files) {
+        if (file.isLocalFile()) {
+            [urls addObject:[NSURL fileURLWithPath:file.toLocalFile().toNSString()]];
+        }
+    }
+    return urls;
+}
+
+void detachResponder()
+{
+    DolphinQuickLookSource *controller = source();
+    NSWindow *window = controller.window;
+    if (window && window.nextResponder == controller) {
+        window.nextResponder = controller.previousResponder;
+    }
+    controller.window = nil;
+    controller.previousResponder = nil;
+    controller.nextResponder = nil;
+}
+
+void releaseController(bool hidePanel)
+{
+    DolphinQuickLookSource *controller = source();
+    if (!controller) {
+        return;
+    }
+    controller.enabled = NO;
+    detachResponder();
+    if ([QLPreviewPanel sharedPreviewPanelExists]) {
+        QLPreviewPanel *panel = [QLPreviewPanel sharedPreviewPanel];
+        if (panel.currentController == controller) {
+            if (hidePanel) {
+                lastExplicitClose.start();
+                [panel orderOut:nil];
+            }
+            [panel updateController];
+            // AppKit can retain the controller while its hidden panel is inactive.
+            if (panel.dataSource == controller || panel.delegate == controller) {
+                [controller endPreviewPanelControl:panel];
+            }
+        }
+    }
+    controller.urls = nil;
+    if (!retiredSources) {
+        retiredSources = [NSMutableArray array];
+    }
+    [retiredSources addObject:controller];
+    activeSource = nil;
+    discardReleasedSources();
+    requested = false;
+    openingDeferred = false;
+    ++requestGeneration;
+    panelOwner = nullptr;
+}
+}
+
+bool DolphinQuickLook::isVisible(const QWidget *owner)
+{
+    return requested && panelOwner == owner
+        && (openingDeferred || ([QLPreviewPanel sharedPreviewPanelExists] && [QLPreviewPanel sharedPreviewPanel].visible));
+}
+
+void DolphinQuickLook::show(const QList<QUrl> &files, QWidget *owner)
+{
+    NSArray<NSURL *> *urls = toNSUrls(files);
+    if (urls.count == 0 || !owner) {
+        return;
+    }
+    if (panelOwner) {
+        // Keep the panel visible while changing windows to avoid a hide/show race.
+        releaseController(false);
+    }
+    NSView *view = (__bridge NSView *)reinterpret_cast<void *>(owner->window()->winId());
+    NSWindow *window = view.window;
+    if (!window) {
+        return;
+    }
+    discardReleasedSources();
+    activeSource = [[DolphinQuickLookSource alloc] init];
+    DolphinQuickLookSource *controller = source();
+    controller.urls = urls;
+    controller.enabled = YES;
+    controller.window = window;
+    controller.previousResponder = window.nextResponder;
+    controller.nextResponder = controller.previousResponder;
+    window.nextResponder = controller;
+    panelOwner = owner;
+    requested = true;
+    const auto generation = ++requestGeneration;
+    // Let a recent orderOut finish before reopening the same shared panel.
+    const qint64 remaining = lastExplicitClose.isValid() ? 450 - lastExplicitClose.elapsed() : 0;
+    auto openPanel = [owner, generation] {
+        if (!requested || panelOwner != owner || generation != requestGeneration) {
+            return;
+        }
+        if (openingDeferred && !NSApp.active) {
+            releaseController(true);
+            return;
+        }
+        openingDeferred = false;
+        lastExplicitClose.invalidate();
+        // Showing the panel asks AppKit to select a controller from the responder chain.
+        QLPreviewPanel *panel = [QLPreviewPanel sharedPreviewPanel];
+        [panel orderFront:nil];
+        [panel updateController];
+    };
+    if (remaining > 0) {
+        openingDeferred = true;
+        QTimer::singleShot(static_cast<int>(remaining), owner, openPanel);
+    } else {
+        openPanel();
+    }
+}
+
+void DolphinQuickLook::update(const QList<QUrl> &files, const QWidget *owner)
+{
+    if (!isVisible(owner)) {
+        return;
+    }
+    NSArray<NSURL *> *urls = toNSUrls(files);
+    if (urls.count == 0) {
+        close(owner);
+        return;
+    }
+    source().urls = urls;
+    QLPreviewPanel *panel = [QLPreviewPanel sharedPreviewPanel];
+    if (panel.currentController == source()) {
+        [panel reloadData];
+    }
+}
+
+void DolphinQuickLook::close(const QWidget *owner)
+{
+    if (panelOwner != owner) {
+        return;
+    }
+    releaseController(true);
+}
