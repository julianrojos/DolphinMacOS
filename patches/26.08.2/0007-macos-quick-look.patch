+QList<QUrl> DolphinMainWindow::localSelectedUrls() const
+{
+    QList<QUrl> urls;
+    const KFileItemList selection = m_activeViewContainer->view()->selectedItems();
+    for (const KFileItem &item : selection) {
+        const QUrl url = item.targetUrl();
+        if (url.isLocalFile()) {
+            urls.append(url);
+        }
+    }
+    return urls;
+}
+
+void DolphinMainWindow::toggleQuickLook()
+{
+    if (DolphinQuickLook::isVisible(this)) {
+        closeQuickLook();
+        return;
+    }
+
+    const int selectedCount = m_activeViewContainer->view()->selectedItems().count();
+    if (selectedCount == 0) {
+        return;
+    }
+    const QList<QUrl> urls = localSelectedUrls();
+    if (urls.isEmpty()) {
+        m_activeViewContainer->showMessage(i18nc("@info:status", "Quick Look is only available for files on this Mac."), KMessageWidget::Information);
+        return;
+    }
+    if (urls.count() != selectedCount) {
+        m_activeViewContainer->showMessage(i18nc("@info:status", "Quick Look can only preview the local items in this selection."), KMessageWidget::Information);
+    }
+    ++m_quickLookSelectionGeneration;
+    DolphinQuickLook::show(urls, this);
+}
+
+void DolphinMainWindow::updateQuickLook()
+{
+    const auto generation = ++m_quickLookSelectionGeneration;
+    if (!DolphinQuickLook::isVisible(this)) {
+        return;
+    }
+    const auto urls = localSelectedUrls();
+    if (!urls.isEmpty()) {
+        DolphinQuickLook::update(urls, this);
+        return;
+    }
+    // A folder refresh can briefly clear the selection. Confirm it remains empty.
+    QTimer::singleShot(350, this, [this, generation] {
+        if (generation == m_quickLookSelectionGeneration) {
+            DolphinQuickLook::update(localSelectedUrls(), this);
+        }
+    });
 }
 
+bool DolphinMainWindow::eventFilter(QObject *watched, QEvent *event)
+{
+    // Escape only closes the preview while it is shown. It is consumed here, before it reaches
+    // the focused widget, so it does not also clear the selection or leave the selection mode.
+    // Leave Escape to text editors, search fields and other focused controls.
+    // The state is checked when the key arrives, so a panel closed by its own button is not an issue.
+    if (event->type() == QEvent::KeyPress && static_cast<QKeyEvent *>(event)->key() == Qt::Key_Escape && isActiveWindow()
+        && m_activeViewContainer && !m_activeViewContainer->view()->handleSpaceAsNormalKey() && DolphinQuickLook::isVisible(this)) {
+        closeQuickLook();
+        return true;
+    }
+    return KXmlGuiWindow::eventFilter(watched, event);
+}
+
+void DolphinMainWindow::closeQuickLook()
+{
+    ++m_quickLookSelectionGeneration;
+    DolphinQuickLook::close(this);
+}
