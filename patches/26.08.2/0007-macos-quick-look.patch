+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef DOLPHIN_QUICKLOOK_MACOS_H
+#define DOLPHIN_QUICKLOOK_MACOS_H
+
+#include <QList>
+#include <QUrl>
+
+class QWidget;
+
+/**
+ * Shows the native macOS Quick Look panel for local files.
+ *
+ * Arrow keys received by the panel are forwarded to the owning window, and
+ * the caller refreshes the preview when the selection changes.
+ *
+ * There is a single panel for the whole application. The @p owner is the Qt
+ * window using it, so another window cannot close or update its preview.
+ */
+namespace DolphinQuickLook
+{
+/** @return true if the Quick Look panel is on screen and belongs to @p owner. */
+bool isVisible(const QWidget *owner);
+
+/** Shows the panel for @p files, taking it over from any other owner. Nothing happens if @p files is empty. */
+void show(const QList<QUrl> &files, QWidget *owner);
+
+/** Replaces the previewed files if the panel is visible and belongs to @p owner. Closes it if @p files is empty. */
+void update(const QList<QUrl> &files, const QWidget *owner);
+
+/** Hides the panel if it belongs to @p owner. */
+void close(const QWidget *owner);
+}
+
+#endif
