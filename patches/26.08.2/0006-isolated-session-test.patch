+#ifdef BUILD_TESTING
+static bool sessionTestProfileIsIsolated()
+{
+    const auto root = QFileInfo(qEnvironmentVariable("DOLPHIN_SESSION_TEST_ROOT")).canonicalFilePath();
+    const auto token = qgetenv("DOLPHIN_SESSION_TEST_TOKEN");
+    if (root.isEmpty() || !QFileInfo(root).isDir() || token.size() != 64
+        || !std::all_of(token.cbegin(), token.cend(), [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); })) {
+        return false;
+    }
+    if (QFileInfo(root).dir().canonicalPath() != QFileInfo(QDir::tempPath()).canonicalFilePath()
+        || !QFileInfo(root).fileName().startsWith(QLatin1String("dolphin-session-test-"))) {
+        return false;
+    }
+    for (const auto *name : {"HOME", "CFFIXED_USER_HOME"}) {
+        if (qEnvironmentVariableIsEmpty(name) || QFileInfo(qEnvironmentVariable(name)).canonicalFilePath() != root) {
+            return false;
+        }
+    }
+    const auto expectedConfig = root + QStringLiteral("/Library/Preferences");
+    const auto config = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation);
+    if (QFileInfo(config).canonicalFilePath() != expectedConfig) {
+        return false;
+    }
+    const auto markerPath = root + QStringLiteral("/.session-test-profile");
+    const QFileInfo markerInfo(markerPath);
+    QFile marker(markerPath);
+    return !markerInfo.isSymLink() && markerInfo.isFile() && marker.open(QIODevice::ReadOnly)
+        && marker.readAll() == token;
+}
+#endif
+
